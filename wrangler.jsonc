{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coc-clan-manager",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "CWL_REQUIRE_BRIDGE": "true", "CWL_BACKEND_REGION": "us-east-1" },
  "ratelimits": [{ "name": "CWL_LOGIN_LIMITER", "namespace_id": "104271001", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  }
}
