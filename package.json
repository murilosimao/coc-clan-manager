{
  "name": "coc-clan-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check:scores": "node scripts/check-war-scores.mjs",
    "test:ui": "node tests/cwl-browser.mjs",
    "demo:cwl": "node scripts/generate-cwl-demo.mjs",
    "db:setup": "node scripts/setup-cwl-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "node --env-file=.env scripts/migrate-cwl.mjs",
    "test:cwl": "node --env-file=.env --test --test-concurrency=1 tests/cwl-planner.test.mjs tests/cwl-ranking.test.mjs tests/cwl.test.mjs",
    "simulate:cwl": "node scripts/simulate-cwl.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  }
}
