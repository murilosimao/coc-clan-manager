{
  "name": "coc-clan-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "preview": "node scripts/preview-local.mjs",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check:scores": "node scripts/check-war-scores.mjs",
    "test:ui": "node tests/cwl-browser.mjs && node tests/cwl-compute-browser.mjs && node tests/cwl-members-browser.mjs && node tests/cwl-score-help-browser.mjs",
    "demo:cwl": "node scripts/generate-cwl-demo.mjs",
    "db:setup": "node scripts/setup-cwl-local.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:migrate": "node --env-file=.env scripts/migrate-cwl.mjs",
    "test:cwl": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/cwl-auth.test.mjs tests/cwl-planner.test.mjs tests/cwl-player-history.test.mjs tests/cwl-ranking.test.mjs tests/cwl-public-plan.test.mjs tests/cwl.test.mjs",
    "simulate:cwl": "node scripts/simulate-cwl.mjs",
    "build:supabase": "node scripts/build-supabase.mjs",
    "test:parity": "node scripts/compare-cwl-browser.mjs",
    "db:supabase:check": "node scripts/prepare-supabase.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "wrangler": "4.151.3"
  },
  "dependencies": {
    "postgres": "^3.4.9"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
